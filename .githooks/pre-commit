#!/bin/sh
# ip-service: a gate like insuit's below. Formatting and re-adding the staged
# paths swept unstaged hunks into the commit and failed on a deleted file.
if git diff --cached --name-only | grep -q '^ip-service/'; then
  (cd ip-service && bun run format:check) || {
    echo "ip-service: formatting check failed — run 'make format' in ip-service/ (or 'make install' first)" >&2
    exit 1
  }
fi

# insuit: a gate, not a fixer — the commit stops until `make format` is run.
# It also stops when oxfmt is missing (a fresh worktree before `make install`),
# which is how an unformatted file once reached CI.
if git diff --cached --name-only | grep -q '^insuit/'; then
  (cd insuit && bun run format) || {
    echo "insuit: formatting check failed — run 'make format' in insuit/ (or 'make install' first)" >&2
    exit 1
  }
fi
