#!/bin/sh
# Mounted over `git` in the runner container, in front of /usr/bin/git.
#
# The runner reuses its cached clone of an action only while
# `git remote get-url origin` equals the `uses:` URL, and get-url applies
# insteadOf — so with the LAN rewrite on, every `uses:` would re-clone and
# delete the cache from under a worktree still in use. Drop the rewrite there.
#
# The runner also scopes the job token to https://git.insuit.cz/, which the
# rewritten request no longer matches. Send it to the LAN origin as well.
#
# ponytail: matches the runner's argument shape (forgejo-runner 13). Delete this
# file once the runner compares `remote.origin.url` instead of get-url.
case " $* " in
  *" remote get-url "*) unset GIT_CONFIG_COUNT ;;
esac
if [ -n "$GIT_AUTH_HEADER" ] && [ -n "$FORGEJO_INTERNAL_URL" ]; then
  set -- --config-env "http.$FORGEJO_INTERNAL_URL/.extraHeader=GIT_AUTH_HEADER" "$@"
fi
exec /usr/bin/git "$@"
