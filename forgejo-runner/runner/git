#!/bin/sh
# Mounted over `git` in the runner container, in front of /usr/bin/git.
#
# Sends the runner's own action fetches for <instance>/tools-mirror/ to
# FORGEJO_INTERNAL_URL instead of out through Cloudflare, the instance being the
# one runner/config.yml connects to. Those are the calls
# that start with --no-replace-objects. A `self-hosted:host` job runs its steps
# in this container too, and its checkout is left alone.
#
# Only the mirrors: that is the one path published on the tailnet name next to
# the registry (../forgejo/Makefile, SERVE_PATHS). Rewriting the whole instance
# would turn every other repository into a 404 instead of a slower fetch.
#
# Not for `remote get-url`: the runner reuses its cached clone of an action only
# while that equals the `uses:` URL, and get-url applies insteadOf.
#
# The runner scopes the job token to the instance, so it is not sent
# to the tailnet name either. An action fetched this way has to be public.
#
# ponytail: matches forgejo-runner 13's argument shape. If an upgrade stops
# sending --no-replace-objects first, fetches quietly go back through Cloudflare.
#
# The runner's calls also wait out another job's lock. Jobs that start together
# fetch the same action into one shared clone under data/.cache/act, and the
# second one met "Unable to create '…/shallow.lock': File exists" and failed in
# two seconds, before its checkout. Such a call is tried again, a second apart,
# up to GIT_LOCK_TRIES times; any other failure is passed on at once.
set -u
git=${GIT_REAL:-/usr/bin/git}
# The organisation the actions are mirrored under: workflows name it in `uses:`, so it is the same on both sides.
MIRRORS=tools-mirror

[ "${1:-}" = --no-replace-objects ] || exec "$git" "$@"

# The instance is the one the runner connects to, read from its config rather than written here a second time.
# Not found: nothing is rewritten, and the job's log says why its fetches went the long way.
if [ -n "${FORGEJO_INTERNAL_URL:-}" ]; then
  case " $* " in
    *" remote get-url "*) ;;
    *)
      forgejo=$(sed -n "s/^ *url: *['\"]\{0,1\}\(https\{0,1\}:[^'\" ]*\).*/\1/p" "${RUNNER_CONFIG:-/data/config.yml}" 2>/dev/null | head -n 1)
      if [ -n "$forgejo" ]; then
        set -- -c "url.${FORGEJO_INTERNAL_URL%/}/$MIRRORS/.insteadOf=${forgejo%/}/$MIRRORS/" "$@"
      else
        echo "runner git wrapper: no forgejo url in ${RUNNER_CONFIG:-/data/config.yml}, fetching $MIRRORS without the tailnet" >&2
      fi
      ;;
  esac
fi

tries=${GIT_LOCK_TRIES:-15}
err=$(mktemp)
trap 'rm -f "$err"' EXIT
attempt=1
while :; do
  status=0
  "$git" "$@" 2>"$err" || status=$?
  if [ "$status" -ne 0 ] && [ "$attempt" -lt "$tries" ] && grep -q "\.lock': File exists" "$err"; then
    attempt=$((attempt + 1))
    sleep "${GIT_LOCK_WAIT:-1}"
    continue
  fi
  cat "$err" >&2
  exit "$status"
done
