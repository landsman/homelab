# macOS
.DS_Store

# Node deps, the build, and the router plugin's scratch folder.
node_modules/
dist/
.tanstack/

# OG fonts — symlinks into @fontsource (node_modules), recreated by
# `make install`; no font is committed for the card.
og/*.woff2

# OG card — rendered by `make og`, regenerated in CI and handed to the deploy
# as an artifact, never committed.
public/assets/icons/og-image.png

# The printed CV's QR codes and the pictures' thumbnails — written by
# vite/cv.ts whenever the CV is built.
public/assets/cv-qr.svg
public/assets/cv-thumbs/

# The compiled message catalogue — written by Paraglide from messages/*.json on
# every build. (project.inlang/ keeps its own ignore file: all but settings.json.)
src/paraglide/

# Playwright
test-results/
playwright-report/
