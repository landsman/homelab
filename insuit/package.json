{
  "name": "insuit-cz",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy baseLocale --silent",
    "prebuild": "bun run messages",
    "build": "tsc -b && vite build",
    "preview": "bun scripts/preview.ts",
    "pretypecheck": "bun run messages",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:bdd": "bun --bun cucumber-js",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "gtm:validate": "gtm-code validate -c analytics/analytics.yaml",
    "gtm:plan": "gtm-code plan -c analytics/analytics.yaml",
    "gtm:apply": "gtm-code apply -c analytics/analytics.yaml"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cucumber/cucumber": "^13.3.0",
    "@fontsource/fira-mono": "^5.2.6",
    "@inlang/paraglide-js": "^2.27.0",
    "@inlang/plugin-message-format": "^4.5.4",
    "@mdx-js/rollup": "3.1.1",
    "@playwright/test": "^1.64.1",
    "@shikijs/rehype": "4.5.0",
    "@stackmade/gtm-as-code": "0.9.2",
    "@types/bun": "^1.4.3",
    "@types/mdx": "2.0.14",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "marked": "^18.1.1",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "qrcode": "^1.5.4",
    "rehype-unwrap-images": "1.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "bun@1.4.2"
}
