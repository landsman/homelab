# MariaDB — the container creates this database and user on first start.
MARIADB_ROOT_PASSWORD=change-me
MARIADB_DATABASE=matomo
MARIADB_USER=matomo
MARIADB_PASSWORD=change-me-too

# Matomo — pre-fills the installer's database step. Same values as above.
MATOMO_DATABASE_ADAPTER=mysql
MATOMO_DATABASE_TABLES_PREFIX=matomo_
MATOMO_DATABASE_USERNAME=matomo
MATOMO_DATABASE_PASSWORD=change-me-too
MATOMO_DATABASE_DBNAME=matomo
