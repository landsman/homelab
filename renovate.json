{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only what Dependabot cannot see. forgejo-mcp is built from a git tag on a Forgejo, not pulled as an image, so no Dependabot ecosystem reads it.",
  "extends": [":disableDependencyDashboard"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^forgejo-mcp/compose\\.yml$/"],
      "matchStrings": ["(?:forgejo-mcp\\.git#|VERSION: |forgejo-mcp:)(?<currentValue>v\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "forgejo-tags",
      "registryUrlTemplate": "https://git.b4mad.industries",
      "depNameTemplate": "agentic-forges/forgejo-mcp"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["custom.regex"],
      "minimumReleaseAge": "7 days",
      "commitMessagePrefix": "deps(forgejo-mcp):"
    }
  ]
}
