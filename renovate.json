{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only what Dependabot cannot see: the Grafana plugins pinned in telemetry/compose.yml. Dependabot keeps everything else.",
  "enabledManagers": ["custom.regex"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "commitMessagePrefix": "deps:",
  "commitMessageAction": "bump",
  "commitMessageTopic": "{{depName}}",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "grafana-*-app@x.y.z in GF_PLUGINS_PREINSTALL",
      "managerFilePatterns": ["/^telemetry/compose\\.yml$/"],
      "matchStrings": ["(?<depName>grafana-[a-z0-9-]+-app)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "datasourceTemplate": "custom.grafana-plugins"
    }
  ],
  "customDatasources": {
    "grafana-plugins": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/plugins/{{packageName}}/versions",
      "transformTemplates": [
        "{\"releases\": items.{\"version\": version, \"releaseTimestamp\": createdAt}, \"sourceUrl\": \"https://grafana.com/grafana/plugins/\"}"
      ]
    }
  }
}
