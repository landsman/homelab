{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "forgejo-mcp, which Dependabot cannot see: it is built from a git tag on a Forgejo, not pulled as an image. And authelia, so that one bot bumps both Tailscale sidecars in one PR and they never drift apart. ignoreDeps keeps the docker-compose manager from looking up the locally built forgejo-mcp image on a registry. And the Grafana plugins pinned in telemetry/compose.yml; Dependabot keeps that file's images.",
  "commitMessageAction": "bump",
  "extends": [
    ":disableDependencyDashboard"
  ],
  "enabledManagers": [
    "custom.regex",
    "docker-compose"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^forgejo-mcp/compose\\.yml$/"
      ],
      "matchStrings": [
        "forgejo-mcp\\.git#(?<currentDigest>[0-9a-f]{40}) # (?<currentValue>v\\d+\\.\\d+\\.\\d+)",
        "(?:VERSION: |forgejo-mcp:)(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "forgejo-tags",
      "registryUrlTemplate": "https://git.b4mad.industries",
      "depNameTemplate": "agentic-forges/forgejo-mcp"
    },
    {
      "customType": "regex",
      "description": "grafana-*-app@x.y.z in GF_PLUGINS_PREINSTALL",
      "managerFilePatterns": [
        "/^telemetry/compose\\.yml$/"
      ],
      "matchStrings": [
        "(?<depName>grafana-[a-z0-9-]+-app)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "custom.grafana-plugins"
    }
  ],
  "packageRules": [
    {
      "matchFileNames": [
        "forgejo-mcp/**"
      ],
      "minimumReleaseAge": "7 days",
      "commitMessagePrefix": "deps(forgejo-mcp):"
    },
    {
      "matchFileNames": [
        "authelia/**"
      ],
      "minimumReleaseAge": "7 days",
      "commitMessagePrefix": "deps(authelia):"
    },
    {
      "matchFileNames": [
        "telemetry/**"
      ],
      "matchManagers": [
        "docker-compose"
      ],
      "enabled": false
    },
    {
      "matchFileNames": [
        "telemetry/**"
      ],
      "minimumReleaseAge": "7 days",
      "commitMessagePrefix": "deps(telemetry):"
    },
    {
      "description": "A plugin's major usually needs a newer Grafana than the pinned image (metricsdrilldown 3.x wants 13.3); take those with the Grafana bump, by hand.",
      "matchDatasources": [
        "custom.grafana-plugins"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    }
  ],
  "includePaths": [
    "forgejo-mcp/**",
    "authelia/**",
    "telemetry/compose.yml"
  ],
  "ignoreDeps": [
    "forgejo-mcp"
  ],
  "customDatasources": {
    "grafana-plugins": {
      "defaultRegistryUrlTemplate": "https://grafana.com/api/plugins/{{packageName}}/versions",
      "transformTemplates": [
        "{\"releases\": items.{\"version\": version, \"releaseTimestamp\": createdAt}, \"sourceUrl\": \"https://grafana.com/grafana/plugins/\"}"
      ]
    }
  },
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": null
  }
}
