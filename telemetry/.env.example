# pick an admin name other than "admin", the first one anyone tries
GF_SECURITY_ADMIN_USER=
GF_SECURITY_ADMIN_PASSWORD=
# the public address once Grafana is on the tunnel, for links in alerts and emails
# GF_SERVER_ROOT_URL=https://grafana.example.com/
# rootful Docker only; rootless finds its socket in $XDG_RUNTIME_DIR
# DOCKER_SOCKET=/var/run/docker.sock
