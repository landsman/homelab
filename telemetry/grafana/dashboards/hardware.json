{
  "uid": "hardware",
  "title": "Hardware",
  "description": "Physical health of every host: fleet table on top, one collapsed row per host.",
  "tags": [
    "homelab"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "name": "Reboots",
        "expr": "(node_boot_time_seconds - node_boot_time_seconds offset 5m) > 60",
        "step": "60s",
        "titleFormat": "{{instance}} rebooted",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "purple",
        "name": "Container restarts",
        "expr": "resets(docker_container_status_uptime_ns[5m]) > 0",
        "step": "60s",
        "titleFormat": "{{container_name}} restarted",
        "useValueForTime": false
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "homelab"
      ],
      "asDropdown": false,
      "title": "Homelab",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Fleet",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "expr": "max by (instance) (up{job=\"node\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (time() - node_boot_time_seconds)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (node_hwmon_temp_celsius * on (instance, chip) group_left (chip_name) node_hwmon_chip_names{chip_name=~\"coretemp|k10temp|zenpower|cpu_thermal\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "E",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (100 * (1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|fuse.*|nsfs\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|ramfs|overlay|squashfs|fuse.*|nsfs\"}))",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "F",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (instance) (node_filesystem_readonly{fstype!~\"tmpfs|ramfs|overlay|squashfs|fuse.*|nsfs\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "G",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (nvme_percentage_used_ratio) * 100",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "H",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (nvme_critical_warning_total)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "I",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (instance) (apt_upgrades_pending)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "J",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (instance) (node_reboot_required)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table",
          "refId": "K",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "minWidth": 60
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "instance"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Only ${__value.raw}",
                    "url": "/d/hardware/hardware?var-host=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #A"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "up"
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "down",
                        "color": "red"
                      },
                      "1": {
                        "text": "up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #B"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "uptime"
              },
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Value #C"
